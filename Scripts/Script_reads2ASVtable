cutFs_run2 <- file.path(cut_path_run2, paste0(sample.names.run2, "_R1.cutadapt.fastq.gz"))
cutRs_run2 <- file.path(cut_path_run2, paste0(sample.names.run2, "_R2.cutadapt.fastq.gz"))

